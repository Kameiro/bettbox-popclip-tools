<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Extension Name</key>
  <string>Bettbox 域名覆写</string>
  <key>Extension Identifier</key>
  <string>local.luna.popclip.bettbox-domain</string>
  <key>Extension Version</key>
  <string>1.0.0</string>
  <key>Extension Description</key>
	<string>通过命令添加 Bettbox 域名规则、检查实际连接，并扫描网页引用的域名。</string>
  <key>Required Software Version</key>
  <integer>4151</integer>
  <key>Actions</key>
  <array>
    <dict>
      <key>Title</key>
      <string>加入 Bettbox</string>
      <key>Icon</key>
			<string>symbol:plus.circle</string>
      <key>Requirements</key>
      <array>
        <string>copy</string>
      </array>
      <key>Regular Expression</key>
      <string>(?i)^\s*(?:(?:https?://)(?![^\s/]*[@*])[^\s]+|(?!(?:\d{1,3}\.){3}\d{1,3}\.?$)(?!localhost\.?$)(?!.*[@*:/?#])[^\s.]+(?:\.[^\s.]+)+\.?)\s*$</string>
      <key>Shell Script File</key>
      <string>add_domain.py</string>
      <key>Script Interpreter</key>
      <string>/usr/bin/python3</string>
      <key>After</key>
      <string>show-status</string>
    </dict>
    <dict>
      <key>Title</key>
      <string>检查域名</string>
      <key>Icon</key>
			<string>symbol:checkmark.circle</string>
      <key>Requirements</key>
      <array>
        <string>copy</string>
      </array>
      <key>Regular Expression</key>
      <string>(?i)^\s*(?:(?:https?://)(?![^\s/]*[@*])[^\s]+|(?!(?:\d{1,3}\.){3}\d{1,3}\.?$)(?!localhost\.?$)(?!.*[@*:/?#])[^\s.]+(?:\.[^\s.]+)+\.?)\s*$</string>
      <key>Shell Script File</key>
      <string>inspect_domain.py</string>
      <key>Script Interpreter</key>
      <string>/usr/bin/python3</string>
      <key>After</key>
      <string>show-status</string>
    </dict>
    <dict>
      <key>Title</key>
			<string>捕获网页域名</string>
      <key>Icon</key>
			<string>symbol:doc.text.magnifyingglass</string>
      <key>Requirements</key>
      <array>
        <string>copy</string>
      </array>
      <key>Regular Expression</key>
      <string>(?i)^\s*(?:(?:https?://)(?![^\s/]*[@*])[^\s]+|(?!(?:\d{1,3}\.){3}\d{1,3}\.?$)(?!localhost\.?$)(?!.*[@*:/?#])[^\s.]+(?:\.[^\s.]+)+\.?)\s*$</string>
      <key>Shell Script File</key>
      <string>scan_web_domains.py</string>
      <key>Script Interpreter</key>
      <string>/usr/bin/python3</string>
      <key>After</key>
      <string>show-status</string>
    </dict>
  </array>
</dict>
</plist>
